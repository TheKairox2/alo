local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

--------------------------------------------------------------------------------
-- CONFIGURATION STATE
--------------------------------------------------------------------------------
local Config = {
	-- Aimbot / Target Settings
	AimbotEnabled = true,
	MaxRange = 500.0,             -- Extended max targeting range (studs)
	MaxScreenAngle = 180.0,       -- Maximum angle allowance
	PredictionEnabled = true,
	PredictionFactor = 0.2,
	RequireLineOfSight = false,   -- Set false to target through walls / obstacles
	
	-- ESP / Visual Settings
	EspEnabled = true,
	EspFillColor = Color3.fromRGB(0, 255, 170),
	EspOutlineColor = Color3.fromRGB(255, 255, 255),
	EspFillTransparency = 0.5,
	EspOutlineTransparency = 0.0,
	
	-- Controls
	KeybindToggle = Enum.KeyCode.Q,
	KeybindClear = Enum.KeyCode.C,
}

--------------------------------------------------------------------------------
-- GLOBAL API (For moves/weapons to query precise target coordinates)
--------------------------------------------------------------------------------
_G.KairoxAim = {}

local currentTarget: Model? = nil
local calculatedTargetPosition = Vector3.new()
local lastTargetPosition = Vector3.new()
local lastTick = tick()

function _G.KairoxAim.GetTargetPosition(): Vector3?
	if not Config.AimbotEnabled or not currentTarget then return nil end
	return calculatedTargetPosition
end

function _G.KairoxAim.GetTargetModel(): Model?
	if not Config.AimbotEnabled then return nil end
	return currentTarget
end

--------------------------------------------------------------------------------
-- CLOSE-RANGE ENHANCED TARGET SELECTION LOGIC
--------------------------------------------------------------------------------
local function getCharacterRoot(character: Model?): BasePart?
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function findBestTarget(): Model?
	if not Config.AimbotEnabled then return nil end

	local localChar = LocalPlayer.Character
	local localRoot = getCharacterRoot(localChar)
	if not localRoot then return nil end

	local viewportSize = Camera.ViewportSize
	local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)

	local bestTarget: Model? = nil
	local closestScore = math.huge

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			local targetRoot = getCharacterRoot(char)

			if humanoid and humanoid.Health > 0 and targetRoot then
				local distance = (targetRoot.Position - localRoot.Position).Magnitude

				if distance <= Config.MaxRange then
					local hasSight = true
					if Config.RequireLineOfSight then
						local rayParams = RaycastParams.new()
						rayParams.FilterType = Enum.RaycastFilterType.Exclude
						rayParams.FilterDescendantsInstances = {localChar, char}
						local rayResult = Workspace:Raycast(localRoot.Position, targetRoot.Position - localRoot.Position, rayParams)
						if rayResult then hasSight = false end
					end

					if hasSight then
						-- Close-range fix (< 20 studs): prioritize proximity over screen angle
						if distance < 20.0 then
							if distance < closestScore then
								closestScore = distance
								bestTarget = char
							end
						else
							local screenPoint, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
							if onScreen then
								local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
								local screenDist = (screenPos2D - screenCenter).Magnitude
								
								if screenDist < closestScore then
									closestScore = screenDist
									bestTarget = char
								end
							end
						end
					end
				end
			end
		end
	end

	return bestTarget
end

--------------------------------------------------------------------------------
-- ESP (HIGHLIGHT) SYSTEM MANAGEMENT
--------------------------------------------------------------------------------
local activeHighlights: {[Player]: Highlight} = {}

local function updateEsp()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			
			if Config.EspEnabled and humanoid and humanoid.Health > 0 then
				local highlight = activeHighlights[player]
				if not highlight or highlight.Parent ~= char then
					if highlight then highlight:Destroy() end
					highlight = Instance.new("Highlight")
					highlight.Name = "KairoxESP"
					highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					highlight.Parent = char
					activeHighlights[player] = highlight
				end
				
				highlight.FillColor = Config.EspFillColor
				highlight.OutlineColor = Config.EspOutlineColor
				highlight.FillTransparency = Config.EspFillTransparency
				highlight.OutlineTransparency = Config.EspOutlineTransparency
				highlight.Enabled = true
			else
				if activeHighlights[player] then
					activeHighlights[player].Enabled = false
				end
			end
		else
			if activeHighlights[player] then
				activeHighlights[player]:Destroy()
				activeHighlights[player] = nil
			end
		end
	end
end

Players.PlayerRemoving:Connect(function(player)
	if activeHighlights[player] then
		activeHighlights[player]:Destroy()
		activeHighlights[player] = nil
	end
end)

--------------------------------------------------------------------------------
-- RUNTIME UPDATE LOOP
--------------------------------------------------------------------------------
RunService.RenderStepped:Connect(function(dt)
	-- ESP Update
	updateEsp()

	-- Targeting Calculations
	if not Config.AimbotEnabled then
		currentTarget = nil
		return
	end

	if currentTarget then
		local humanoid = currentTarget:FindFirstChildOfClass("Humanoid")
		local targetRoot = getCharacterRoot(currentTarget)
		local localRoot = getCharacterRoot(LocalPlayer.Character)

		if not humanoid or humanoid.Health <= 0 or not targetRoot or not localRoot or (targetRoot.Position - localRoot.Position).Magnitude > Config.MaxRange then
			currentTarget = nil
		end
	end

	if not currentTarget then
		currentTarget = findBestTarget()
	end

	if currentTarget then
		local targetRoot = getCharacterRoot(currentTarget)
		if targetRoot then
			local targetPos = targetRoot.Position

			if Config.PredictionEnabled then
				local currentTick = tick()
				local timeDelta = currentTick - lastTick
				if timeDelta > 0 then
					local velocity = (targetPos - lastTargetPosition) / timeDelta
					targetPos = targetPos + (velocity * Config.PredictionFactor)
				end
				lastTargetPosition = targetRoot.Position
				lastTick = currentTick
			end

			calculatedTargetPosition = targetPos
		end
	end
end)

